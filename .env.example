# Porta do servidor Express
PORT=3000

# Caminho do banco SQLite (relativo à raiz do projeto)
DB_PATH=database.db

# Pasta persistente para imagens enviadas (relativa à raiz; use volume persistente em produção)
UPLOADS_DIR=uploads

# Acesso de administrador
ADMIN_USER=Admin
ADMIN_PASSWORD=troque-esta-senha

# Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
